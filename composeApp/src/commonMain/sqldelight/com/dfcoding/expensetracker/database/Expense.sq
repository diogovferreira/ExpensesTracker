CREATE TABLE Pocket (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL DEFAULT '',
    icon TEXT NOT NULL,
    date INTEGER NOT NULL,
    currency TEXT NOT NULL
);

CREATE TABLE Expense (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    amount REAL NOT NULL,
    category TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    date INTEGER NOT NULL,
    pocketId INTEGER REFERENCES Pocket(id) ON DELETE CASCADE
);

-- Queries

getAllPockets:
SELECT * FROM Pocket
ORDER BY date DESC;

getPocketById:
SELECT * FROM Pocket
WHERE id = ?;

insertPocket:
INSERT INTO Pocket(name,icon,date,currency)
VALUES(?,?,?,?);

updatePocket:
UPDATE Pocket
SET name = ?, icon = ?, date = ?, currency = ?
WHERE id = ?;

deletePocket:
DELETE FROM Pocket
WHERE id = ?;

getAllExpenses:
SELECT * FROM Expense
ORDER BY date DESC;

getExpenseById:
SELECT * FROM Expense
WHERE id = ?;

insertExpense:
INSERT INTO Expense(amount, category, description, date, pocketId)
VALUES (?, ?, ?, ?,?);

updateExpense:
UPDATE Expense
SET amount = ?, category = ?, description = ?, date = ?, pocketId = ?
WHERE id = ?;

deleteExpense:
DELETE FROM Expense
WHERE id = ?;

deleteAllExpenses:
DELETE FROM Expense;

getTotalAmount:
SELECT SUM(amount) AS total FROM Expense;

getTotalByCategory:
SELECT category, SUM(amount) AS total
FROM Expense
GROUP BY category
ORDER BY total DESC;

getExpensesByDateRange:
SELECT * FROM Expense
WHERE date >= ? AND date <= ?
ORDER BY date DESC;

getTotalNumberOfExpenses:
SELECT COUNT(*) FROM Expense;



